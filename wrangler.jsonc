{
  // QCR Workbench v2 — Cloudflare-native. A single Worker serves the built
  // React SPA (Static Assets) and an /api/* backend backed by D1. This replaces
  // the v1 Pages (static-only) deployment on the main branch.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qcr-workbench-v2",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  // Apex custom domain. Cloudflare provisions DNS + cert on deploy — but the
  // apex must first be DETACHED from the v1 Pages project (a hostname can't be
  // on both Pages and a Worker), or the deploy errors with a route conflict.
  // See the cutover runbook. v1 moves to local.qcr-workbench.org (Pages side).
  "routes": [{ "pattern": "qcr-workbench.org", "custom_domain": true }],
  // Let the Worker bundle reuse the SPA's domain math via its '@/…' imports
  // (esbuild resolves the subpath alias, same as Vite/jsconfig do).
  "alias": { "@": "./src" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // SPA: unknown non-asset paths fall back to index.html (client router).
    "not_found_handling": "single-page-application",
    // Hit the Worker first for the API and the MCP endpoint; everything else is
    // a static asset served directly.
    "run_worker_first": ["/api/*", "/mcp"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qcr-workbench-db",
      "database_id": "d6376a28-4894-408c-9fbb-57a29e1e5d11",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
