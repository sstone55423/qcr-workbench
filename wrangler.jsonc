{
  // QCR Workbench v2 — Cloudflare-native. A single Worker serves the built
  // React SPA (Static Assets) and an /api/* backend backed by D1. This replaces
  // the v1 Pages (static-only) deployment on the main branch.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qcr-workbench-v2",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  // Keep the workers.dev URL on. wrangler 4 disables it by default once routes/
  // custom domains are present; we want the public /mcp reachable at
  // qcr-workbench-v2.<subdomain>.workers.dev.
  "workers_dev": true,
  // Custom domains for the cutover — PARKED until the apex is detached from the
  // v1 Pages project. Attaching qcr-workbench.org while Pages still owns its DNS
  // fails with "hostname already has externally managed DNS records" [100117].
  // Cutover: (1) add local.qcr-workbench.org to the v1 Pages project, (2) remove
  // qcr-workbench.org from Pages, (3) uncomment below, (4) `npm run cf:deploy`.
  // "routes": [
  //   { "pattern": "qcr-workbench.org", "custom_domain": true },
  //   { "pattern": "www.qcr-workbench.org", "custom_domain": true }
  // ],
  // Let the Worker bundle reuse the SPA's domain math via its '@/…' imports
  // (esbuild resolves the subpath alias, same as Vite/jsconfig do).
  "alias": { "@": "./src" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // SPA: unknown non-asset paths fall back to index.html (client router).
    "not_found_handling": "single-page-application",
    // Hit the Worker first for the API, the MCP endpoint, and OAuth-discovery
    // probes (so the Worker can 404 them for the no-auth MCP server instead of
    // the SPA fallback answering with HTML). Everything else is a static asset.
    "run_worker_first": ["/api/*", "/mcp", "/.well-known/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qcr-workbench-db",
      "database_id": "d6376a28-4894-408c-9fbb-57a29e1e5d11",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
